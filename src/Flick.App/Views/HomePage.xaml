<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flick.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="16" MaxWidth="980" Padding="0,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Control trigger engines and view your active shortcuts at a glance." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Hero Status Card -->
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="StatusIconBadge"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B0;" FontSize="20" Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="StatusTitleText" Text="Flick Engine Active" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Border x:Name="StatusPill" CornerRadius="10" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusPillText" Text="LIVE" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusSubtitleText" Text="Listening for triggers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="EngineToggle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        OnContent="Active"
                        OffContent="Paused"
                        Toggled="EngineToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Interactive Trigger Engines -->
            <Border
                Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Trigger Engines" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- Touchpad -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE815;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Precision Touchpad" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TouchpadSubText" Text="2–5 finger swipes, taps, and pinches" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TouchpadQuickToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="TriggerQuickToggle_Toggled" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Keyboard Chords -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Keyboard Chords" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChordSubText" Text="Simultaneous &amp; sequential modifier chords" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ChordQuickToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="TriggerQuickToggle_Toggled" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Acoustic Knock -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE720;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Acoustic Knock Detection" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="KnockSubText" Text="Surface-calibrated knock patterns" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="KnockQuickToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="TriggerQuickToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active Rules Cheat-Sheet -->
            <Border
                Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Active Triggers &amp; Actions" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RulesSummaryText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        x:Name="EmptyRulesText"
                        Text="No active rules yet. Select Global or an App Scope on the left to add gestures, chords, or knock patterns."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ItemsControl x:Name="ActiveRulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,8" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="4" Padding="6,1">
                                                    <TextBlock Text="{Binding ScopeLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" IsOn="{Binding IsEnabled, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" Tag="{Binding Id}" Toggled="RuleQuickToggle_Toggled" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
