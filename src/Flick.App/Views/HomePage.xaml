<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flick.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="18" Padding="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Control your trigger engines at a glance." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Hero Status Card -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="StatusIconBadge"
                    Grid.Column="0"
                    Width="44"
                    Height="44"
                    CornerRadius="10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/flick.png" Width="30" Height="30" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitleText" Text="Flick Engine Active" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="StatusSubtitleText" Text="Listening for enabled triggers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ToggleSwitch
                    x:Name="EngineToggle"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    MinWidth="0"
                    OnContent=""
                    OffContent=""
                    Toggled="EngineToggle_Toggled" />
            </Grid>
        </Border>

        <!-- Interactive Trigger Engines -->
        <Border
            x:Name="TriggerEnginesCard"
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20,16">
            <StackPanel Spacing="14">
                <TextBlock Text="Trigger Engines" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <!-- Touchpad -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TouchpadBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon x:Name="TouchpadIcon" Glyph="&#xE815;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Precision Touchpad" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="TouchpadSubText" Text="2–5 finger swipes, taps, and pinches" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TouchpadQuickToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Toggled="TriggerQuickToggle_Toggled" />
                </Grid>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Keyboard Chords -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ChordBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon x:Name="ChordIcon" Glyph="&#xE765;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Keyboard Chords" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ChordSubText" Text="Simultaneous &amp; sequential modifier chords" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ChordQuickToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Toggled="TriggerQuickToggle_Toggled" />
                </Grid>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Acoustic Knock -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KnockBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon x:Name="KnockIcon" Glyph="&#xE720;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Acoustic Knock Detection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="KnockSubText" Text="Surface-calibrated knock patterns" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="KnockQuickToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Toggled="TriggerQuickToggle_Toggled" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
