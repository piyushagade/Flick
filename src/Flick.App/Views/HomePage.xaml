<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flick.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="18" MaxWidth="980" Padding="0,0,4,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Overview of your trigger engines, active rules, and calibrated surfaces." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Hero Status Card -->
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="StatusIconBadge"
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B0;" FontSize="20" Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="StatusTitleText" Text="Flick Engine Active" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Border x:Name="StatusPill" CornerRadius="10" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusPillText" Text="LIVE" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusSubtitleText" Text="All enabled trigger engines are listening." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="EngineToggle"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        OnContent="Active"
                        OffContent="Paused"
                        Toggled="EngineToggle_Toggled" />
                </Grid>
            </Border>

            <!-- 2x2 Trigger Engines Grid -->
            <Grid Grid.Row="2" RowSpacing="14" ColumnSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Mouse Gestures -->
                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE962;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Mouse Gestures" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TriggerButtonText" Text="Right Button" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="TriggerSubText" Text="28 px min drag" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Precision Touchpad -->
                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE815;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Precision Touchpad" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TouchpadStatusText" Text="2–5 Fingers" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="TouchpadSubText" Text="Precision Touchpad ready" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Keyboard Chords -->
                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Keyboard Chords" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ChordStatusText" Text="Active" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ChordSubText" Text="Simultaneous &amp; Sequential" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Acoustic Knock Detection -->
                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Acoustic Knock Detection" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="KnockStatusText" Text="Off" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="KnockSubText" Text="0 calibrated surfaces" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Summary Strip -->
            <Grid Grid.Row="3" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Configured Actions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="TotalRulesSubText" Text="0 total across Global" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="ActiveRulesCountText" Grid.Column="1" Text="0" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Session Triggers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SessionSubText" Text="0 actions executed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="SessionCountText" Grid.Column="1" Text="0" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
