<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flick.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="18" Padding="0,0,14,16">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Customize triggers, recognition thresholds, trail appearance, and startup behavior." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- General -->
            <StackPanel Spacing="8">
                <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="App Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose light, dark, or match Windows system theme" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="170" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="System Default" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Start Flick with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Launch minimized to the system tray on sign-in" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A7;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Minimize to System Tray" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Keep gesture recognition running when closing the window" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MinimizeTrayToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Auto-Pause on Fullscreen Apps &amp; Games" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Automatically suspend gestures when a fullscreen window is active" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FullscreenPauseToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8C1;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Enable Text Expansion" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Expand typed abbreviations with variables, cursor placement, and macros" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TextExpansionToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Trigger & Recognition -->
            <StackPanel Spacing="8">
                <TextBlock Text="Trigger &amp; Recognition" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE962;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Mouse Gesture Trigger" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Hold this mouse button and drag to perform a mouse gesture" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="TriggerButtonCombo" Grid.Column="2" Width="170" SelectionChanged="TriggerButtonCombo_SelectionChanged">
                                <ComboBoxItem Content="Right Button" Tag="Right" />
                                <ComboBoxItem Content="Middle Button" Tag="Middle" />
                                <ComboBoxItem Content="Mouse XButton 1" Tag="XButton1" />
                                <ComboBoxItem Content="Mouse XButton 2" Tag="XButton2" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE737;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Window Action Target" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose whether actions target the active window or the window under the cursor" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="WindowTargetCombo" Grid.Column="2" Width="210" SelectionChanged="WindowTargetCombo_SelectionChanged">
                                <ComboBoxItem Content="Active Window" Tag="ActiveWindow" />
                                <ComboBoxItem Content="Under Cursor (Mouse)" Tag="WindowUnderCursorForMouse" />
                                <ComboBoxItem Content="Under Cursor (Always)" Tag="WindowUnderCursorAlways" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Minimum Mouse Gesture Distance (px)" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="MinLengthLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="MinLengthSlider" Margin="32,0,0,0" Minimum="10" Maximum="150" StepFrequency="2" ValueChanged="SliderChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE720;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Acoustic Knock Pattern Detection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Listen via microphone for knock patterns on touchpad, laptop lid, or desk" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="KnockToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <StackPanel Padding="16,0,16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Knock Detection Sensitivity" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="KnockSensitivityLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="KnockSensitivitySlider" Margin="32,0,0,0" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="SliderChanged" />
                            <ComboBox
                                x:Name="KnockMicCombo"
                                Header="Microphone Device"
                                Margin="32,6,0,0"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="KnockMicCombo_SelectionChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Knock Surface Calibration" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Train Flick to distinguish knocks on your Touchpad, Laptop Lid, or Desk" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CalSurfaceNameCombo" Grid.Column="0" IsEditable="True" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <x:String>Touchpad</x:String>
                                    <x:String>Laptop Lid</x:String>
                                    <x:String>Desk</x:String>
                                </ComboBox>
                                <Button x:Name="CalibrateSurfaceBtn" Grid.Column="1" Content="Calibrate (5×)" Style="{StaticResource AccentButtonStyle}" Click="CalibrateSurfaceBtn_Click" />
                                <Button x:Name="TestSurfaceBtn" Grid.Column="2" Content="Test Detection" Click="TestSurfaceBtn_Click" />
                            </Grid>

                            <TextBlock x:Name="CalStatusText" Text="Select a surface and click Calibrate (5×) to record 5 sample knocks." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <ItemsControl x:Name="CalibratedSurfacesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="10,6" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding SampleCountText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Tag="{Binding Id}" Click="DeleteSurface_Click" ToolTipService.ToolTip="Remove surface">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Recognition Confidence Threshold" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ThresholdLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="ThresholdSlider" Margin="32,0,0,0" Minimum="40" Maximum="90" StepFrequency="5" ValueChanged="SliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Precision Touchpad -->
            <StackPanel Spacing="8">
                <TextBlock Text="Precision Touchpad" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE815;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Multi-Finger Touchpad Gestures" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Recognize 2–5 finger swipes, taps, and pinches on Precision Touchpads" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TouchpadToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE76F;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Minimum Touchpad Gesture Distance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Swipes shorter than this are ignored; multi-finger taps still activate" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="TouchpadSwipeLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="TouchpadSwipeSlider" Margin="32,0,0,0" Minimum="4" Maximum="35" StepFrequency="1" ValueChanged="SliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Trail Overlay -->
            <StackPanel Spacing="8">
                <TextBlock Text="Trail Overlay" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE70F;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show Glowing Gesture Trail" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Display hyper-smoothed colored trails on screen while gesturing" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowTrailToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show Floating Action HUD Pill" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Display the matched action name near the cursor while gesturing" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowHudPillToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Primary Trail Color" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="TrailColorCombo" Grid.Column="2" Width="170" SelectionChanged="TrailColorCombo_SelectionChanged">
                                <ComboBoxItem Content="Windows Blue" Tag="#0078D4" />
                                <ComboBoxItem Content="Emerald Green" Tag="#107C10" />
                                <ComboBoxItem Content="Violet" Tag="#8764B8" />
                                <ComboBoxItem Content="Coral Red" Tag="#E74856" />
                                <ComboBoxItem Content="Amber Gold" Tag="#FFB900" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Trail Thickness" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ThicknessLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="ThicknessSlider" Margin="32,0,0,0" Minimum="2" Maximum="12" StepFrequency="0.5" ValueChanged="SliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Gesture Ripple -->
            <StackPanel Spacing="8">
                <TextBlock Text="Gesture Ripple" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA3A;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show Liquid Glass Ripple" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Refract screen pixels at the cursor when an action triggers" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowRippleToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE740;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Ripple Radius (px)" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RippleRadiusLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="RippleRadiusSlider" Margin="32,0,0,0" Minimum="50" Maximum="200" StepFrequency="5" ValueChanged="SliderChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Ripple Thickness (px)" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RippleThicknessLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="RippleThicknessSlider" Margin="32,0,0,0" Minimum="10" Maximum="60" StepFrequency="2" ValueChanged="SliderChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Padding="16,12" Spacing="6">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEC4A;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="Ripple Speed" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RippleSpeedLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="RippleSpeedSlider" Margin="32,0,0,0" Minimum="0.4" Maximum="2.5" StepFrequency="0.1" ValueChanged="SliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Ignored Applications & Backup -->
            <StackPanel Spacing="8">
                <TextBlock Text="Exclusions &amp; Backup" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="12">
                        <TextBox
                            x:Name="IgnoredAppsBox"
                            Header="Ignored Applications (comma-separated process names)"
                            PlaceholderText="mstsc, vncviewer, cs2"
                            LostFocus="IgnoredAppsBox_LostFocus" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Export Profile..." Click="ExportProfile_Click" />
                            <Button Content="Import Profile..." Click="ImportProfile_Click" />
                            <Button Content="Reset to Defaults" Click="ResetDefaults_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
