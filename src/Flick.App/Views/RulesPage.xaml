<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flick.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedRulesCvs" IsSourceGrouped="True" />
        <CollectionViewSource x:Name="GroupedSnippetsCvs" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock x:Name="ScopeTitleText" Text="Global" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="ScopeSubtitleText" Text="Gestures that apply across all applications." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="DeleteScopeButton" Content="Delete Scope" Visibility="Collapsed" Click="DeleteScope_Click" />
                <Button Style="{StaticResource AccentButtonStyle}" Click="AddRule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Mode Selector: Triggers vs Text Expansion -->
        <SelectorBar x:Name="ModeSelectorBar" Grid.Row="1" SelectionChanged="ModeSelectorBar_SelectionChanged" Margin="-12,0,0,0">
            <SelectorBarItem x:Name="TriggersTabItem" Text="Triggers" Tag="triggers" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE815;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TextExpansionTabItem" Text="Text Expansion" Tag="snippets">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8C1;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- Compact Touchpad Conflict Notice -->
        <InfoBar
            x:Name="ConflictBanner"
            Grid.Row="2"
            IsOpen="False"
            Visibility="Collapsed"
            Severity="Warning"
            IsClosable="True"
            Title="Windows Touchpad Conflict"
            PointerPressed="ConflictBanner_PointerPressed">
            <InfoBar.ActionButton>
                <Button Content="Review on Dashboard" Click="ReviewConflicts_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Search & Grouping Bar -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search gestures or actions..."
                TextChanged="SearchBox_TextChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Group by" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <ComboBox
                    x:Name="GroupByCombo"
                    MinWidth="148"
                    SelectedIndex="0"
                    SelectionChanged="GroupByCombo_SelectionChanged">
                    <ComboBoxItem Content="Trigger Type" Tag="trigger" />
                    <ComboBoxItem Content="# of Fingers" Tag="fingers" />
                    <ComboBoxItem Content="Action Type" Tag="action" />
                    <ComboBoxItem Content="None" Tag="none" />
                </ComboBox>
                <ComboBox
                    x:Name="SnippetGroupByCombo"
                    MinWidth="148"
                    SelectedIndex="0"
                    Visibility="Collapsed"
                    SelectionChanged="GroupByCombo_SelectionChanged">
                    <ComboBoxItem Content="Folder" Tag="folder" />
                    <ComboBoxItem Content="Trigger Mode" Tag="trigger" />
                    <ComboBoxItem Content="Case Mode" Tag="case" />
                    <ComboBoxItem Content="None" Tag="none" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="4"
            Spacing="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <FontIcon x:Name="EmptyStateIcon" Glyph="&#xE815;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitleText" Text="No gestures in this scope yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptySubtitleText" Text="Click + New above to record a mouse or multi-finger touchpad gesture and assign an action." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
        </StackPanel>

        <!-- Rules List -->
        <ListView x:Name="RulesListView" Grid.Row="4" SelectionMode="None">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,0,2">
                                <TextBlock
                                    Text="{Binding Key}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <Border
                                    CornerRadius="10"
                                    Padding="7,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding GroupCount}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,4"
                        Padding="14,12"
                        Opacity="{Binding RowOpacity}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="14" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Vector Gesture Preview -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <ItemsControl
                                        Visibility="{Binding StrokeVisibility}"
                                        ItemsSource="{Binding PreviewStrokes}"
                                        Width="48"
                                        Height="48">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid Width="48" Height="48" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Polyline
                                                        Points="{Binding Points}"
                                                        Stroke="{Binding Stroke}"
                                                        StrokeThickness="2.5"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round" />
                                                    <Polyline
                                                        Points="{Binding ArrowPoints}"
                                                        Stroke="{Binding Stroke}"
                                                        StrokeThickness="2.0"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeEndLineCap="Round" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl
                                        Visibility="{Binding TapIconVisibility}"
                                        ItemsSource="{Binding TapDots}"
                                        Width="48"
                                        Height="48">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid Width="48" Height="48" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse
                                                    Width="7"
                                                    Height="7"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="{Binding DotMargin}"
                                                    Fill="{Binding Fill}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <FontIcon
                                        Glyph="&#xE765;"
                                        FontSize="20"
                                        Visibility="{Binding ChordIconVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <FontIcon
                                        Glyph="&#xE720;"
                                        FontSize="20"
                                        Visibility="{Binding KnockIconVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <FontIcon
                                        Glyph="&#xE945;"
                                        FontSize="20"
                                        Visibility="{Binding EventIconVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                        <TextBlock
                                            Text="{Binding ScopeBadge}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Text="{Binding ActionSummary}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsOn="{Binding IsEnabled, Mode=OneWay}"
                                IsEnabled="{Binding IsEngineActive}"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                Tag="{Binding Id}"
                                Toggled="RuleToggle_Toggled" />

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                                <Button Tag="{Binding Id}" Padding="9,4" Click="EditRule_Click" ToolTipService.ToolTip="Edit action">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock Text="Edit" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding Id}" Padding="9,4" Click="DeleteRule_Click" ToolTipService.ToolTip="Delete action">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" ToolTipService.ToolTip="More actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Duplicate" Tag="{Binding Id}" Click="DuplicateRule_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Move Up (Higher Priority)" Tag="{Binding Id}" Click="MoveRuleUp_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70E;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Move Down (Lower Priority)" Tag="{Binding Id}" Click="MoveRuleDown_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Text Expansion Snippets List -->
        <ListView x:Name="SnippetsListView" Grid.Row="4" SelectionMode="None" Visibility="Collapsed">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,0,2">
                                <TextBlock
                                    Text="{Binding Key}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <Border
                                    CornerRadius="10"
                                    Padding="7,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding GroupCount}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,4"
                        Padding="14,12"
                        Opacity="{Binding RowOpacity}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="14" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Abbreviation Badge -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                MinWidth="76"
                                MaxWidth="140"
                                Height="44"
                                Padding="10,4"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    Text="{Binding Abbreviation}"
                                    FontFamily="Consolas"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Title}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                        <TextBlock
                                            Text="{Binding ModeBadge}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Text="{Binding TemplatePreview}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsOn="{Binding IsEnabled, Mode=OneWay}"
                                IsEnabled="{Binding IsEngineActive}"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                Tag="{Binding Id}"
                                Toggled="SnippetToggle_Toggled" />

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                                <Button Tag="{Binding Id}" Padding="9,4" Click="EditSnippet_Click" ToolTipService.ToolTip="Edit snippet">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock Text="Edit" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding Id}" Padding="9,4" Click="DeleteSnippet_Click" ToolTipService.ToolTip="Delete snippet">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding Id}" Padding="9,4" Click="DuplicateSnippet_Click" ToolTipService.ToolTip="Duplicate snippet">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        <TextBlock Text="Duplicate" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
