<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flick.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16" MaxWidth="980">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock x:Name="ScopeTitleText" Text="Global" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="ScopeSubtitleText" Text="Gestures that apply across all applications." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="DeleteScopeButton" Content="Delete Scope" Visibility="Collapsed" Click="DeleteScope_Click" />
                <Button Style="{StaticResource AccentButtonStyle}" Click="AddRule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="Search gestures or actions..."
            TextChanged="SearchBox_TextChanged" />

        <!-- Empty State -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            Spacing="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE815;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitleText" Text="No gestures in this scope yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptySubtitleText" Text="Click + New above to record a mouse or multi-finger touchpad gesture and assign an action." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
        </StackPanel>

        <!-- Rules List -->
        <ListView x:Name="RulesListView" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,4"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Vector Gesture Preview -->
                                <Border
                                    Width="48"
                                    Height="48"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <ItemsControl
                                            Visibility="{Binding StrokeVisibility}"
                                            ItemsSource="{Binding PreviewStrokes}"
                                            Width="48"
                                            Height="48">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid Width="48" Height="48" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Polyline
                                                            Points="{Binding Points}"
                                                            Stroke="{Binding Stroke}"
                                                            StrokeThickness="2.5"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round" />
                                                        <Polyline
                                                            Points="{Binding ArrowPoints}"
                                                            Stroke="{Binding Stroke}"
                                                            StrokeThickness="2.0"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeEndLineCap="Round" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl
                                            Visibility="{Binding TapIconVisibility}"
                                            ItemsSource="{Binding TapDots}"
                                            Width="48"
                                            Height="48">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid Width="48" Height="48" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="{Binding DotMargin}"
                                                        Fill="{Binding Fill}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <FontIcon
                                            Glyph="&#xE765;"
                                            FontSize="20"
                                            Visibility="{Binding ChordIconVisibility}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding ScopeBadge}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActionSummary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsOn="{Binding IsEnabled, Mode=OneWay}"
                                    OnContent=""
                                    OffContent=""
                                    MinWidth="0"
                                    Tag="{Binding Id}"
                                    Toggled="RuleToggle_Toggled" />
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Tag="{Binding Id}" Click="MoveRuleUp_Click" ToolTipService.ToolTip="Move up (higher priority)">
                                    <FontIcon Glyph="&#xE70E;" FontSize="13" />
                                </Button>
                                <Button Tag="{Binding Id}" Click="MoveRuleDown_Click" ToolTipService.ToolTip="Move down (lower priority)">
                                    <FontIcon Glyph="&#xE70D;" FontSize="13" />
                                </Button>
                                <Button Tag="{Binding Id}" Click="DuplicateRule_Click" ToolTipService.ToolTip="Duplicate action">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                </Button>
                                <Button Tag="{Binding Id}" Click="EditRule_Click" ToolTipService.ToolTip="Edit action">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                </Button>
                                <Button Tag="{Binding Id}" Click="DeleteRule_Click" ToolTipService.ToolTip="Delete action">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
